* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Segoe UI", Arial, sans-serif;
  background-color: #f4f6f8;
  color: #1f2933;
}

.app {
  max-width: 700px;
  margin: 0 auto;
  padding: 24px 16px 60px;
}

.app-header {
  text-align: center;
  margin-bottom: 24px;
}

.app-header h1 {
  margin: 0;
  font-size: 2rem;
  color: #2f3e46;
}

.app-header p {
  margin: 4px 0 0;
  color: #6b7280;
}

.task-form {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.task-input,
.edit-input {
  flex: 1 1 200px;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 1rem;
}

.category-select {
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 1rem;
  background-color: #fff;
}

.add-button {
  padding: 10px 18px;
  border: none;
  border-radius: 8px;
  background-color: #2563eb;
  color: white;
  font-weight: 600;
  cursor: pointer;
}

.add-button:hover {
  background-color: #1d4ed8;
}

.task-stats {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 16px;
  font-weight: 600;
  color: #374151;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}

.filter-group {
  display: flex;
  gap: 6px;
}

.filter-button {
  padding: 8px 14px;
  border: 1px solid #d1d5db;
  border-radius: 20px;
  background-color: #fff;
  cursor: pointer;
  font-size: 0.9rem;
}

.filter-button.active {
  background-color: #2563eb;
  color: white;
  border-color: #2563eb;
}

.task-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.task-item {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  background-color: #fff;
  padding: 12px 16px;
  border-radius: 8px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
}

.task-item.completed .task-text {
  text-decoration: line-through;
  color: #9ca3af;
}

.task-label {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1 1 auto;
  cursor: pointer;
}

.task-text {
  word-break: break-word;
}

.category-tag {
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 600;
  color: white;
}

.category-work {
  background-color: #2563eb;
}

.category-personal {
  background-color: #10b981;
}

.category-urgent {
  background-color: #ef4444;
}

.task-actions {
  display: flex;
  gap: 6px;
}

.edit-button,
.delete-button,
.save-button,
.cancel-button {
  padding: 6px 12px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.85rem;
}

.edit-button {
  background-color: #e5e7eb;
}

.delete-button {
  background-color: #fee2e2;
  color: #b91c1c;
}

.save-button {
  background-color: #d1fae5;
  color: #065f46;
}

.cancel-button {
  background-color: #e5e7eb;
}

.empty-state {
  text-align: center;
  color: #6b7280;
  margin-top: 24px;
}

@media (max-width: 480px) {
  .task-form {
    flex-direction: column;
  }

  .task-stats {
    flex-direction: column;
    gap: 4px;
  }

  .filter-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .task-item {
    flex-direction: column;
    align-items: flex-start;
  }
}
